                       width="820" height="235"
                       fill="rgba(255,215,0,0.18)" stroke="gold" strokeWidth="2.5"
                       arcWidth="14" arcHeight="14"
                       visible="false" mouseTransparent="true"/>

            <!-- OUTPOST click zone (covers entire OUTPOST row) -->
            <Button fx:id="selectOutpostButton" layoutX="18" layoutY="285"
                    prefWidth="820" prefHeight="235"
                    opacity="0.0" onAction="#onSelectOutpost"
                    styleClass="transparent-click-zone"/>

