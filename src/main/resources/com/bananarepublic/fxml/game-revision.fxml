                       width="820" height="205"
                       fill="rgba(255,215,0,0.18)" stroke="gold" strokeWidth="2.5"
                       arcWidth="14" arcHeight="14"
                       visible="false" mouseTransparent="true"/>

            <!-- LAB click zone (covers entire LAB row) -->
            <Button fx:id="selectLabButton" layoutX="18" layoutY="58"
                    prefWidth="820" prefHeight="205"
                    opacity="0.0" onAction="#onSelectLab"
                    styleClass="transparent-click-zone"/>

