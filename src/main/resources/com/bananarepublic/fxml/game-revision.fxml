            </ImageView>

            <!-- X close button (opacity 0 — icon already on image, top-right ~x=785,y=13) -->
            <Button layoutX="785" layoutY="13" onAction="#onCloseBuildPopup" opacity="0.0" prefHeight="62" prefWidth="62" styleClass="transparent-click-zone" />

            <!-- BUILD button image -->
            <ImageView fitHeight="50" fitWidth="153" layoutX="351" layoutY="493" preserveRatio="false" smooth="true">
                <image><Image url="@../images/game_revision/btn_build.png" /></image>
            </ImageView>
            <!-- BUILD button hitbox -->
            <Button layoutX="351" layoutY="493" onAction="#onBuildConfirmed" opacity="0.0" prefHeight="50" prefWidth="153" styleClass="transparent-click-zone" />

        </Pane>

        <!-- BUILDING popup — shown when player clicks an intersection build circle -->
        <Pane fx:id="buildingPopupPane" layoutX="533" layoutY="189" managed="false" prefHeight="702" prefWidth="855" visible="false">

