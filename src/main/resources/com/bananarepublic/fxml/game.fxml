<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="com.bananarepublic.ui.controller.GameController"
           styleClass="responsive-root">

    <AnchorPane fx:id="designPane"
                prefWidth="1920"
                prefHeight="1148">

        <ImageView fitWidth="1920"
                   fitHeight="1148"
                   preserveRatio="false"
                   smooth="true">
            <image>
                <Image url="@../images/game/main_game_bg.png"/>
            </image>
        </ImageView>

        <!-- Settings -->
        <Button layoutX="35"
                layoutY="44"
                prefWidth="72"
                prefHeight="72"
                onAction="#onSettingsClicked"
                styleClass="settings-click-zone"/>

        <!-- Board overlay: nanti HexRenderer render terrain/building di sini -->
        <Pane fx:id="boardPane"
              layoutX="315"
              layoutY="160"
              prefWidth="900"
              prefHeight="620"
              mouseTransparent="false"/>

        <!-- Timer label -->
        <Label fx:id="timerLabel"
                layoutX="140"
                layoutY="970"
                prefWidth="128"
                prefHeight="36"
                text="01:30"
                styleClass="timer-label"/>

        <!-- Bottom action buttons -->
        <Button fx:id="diceButton"
                layoutX="92"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onMouseClicked="#onDiceButtonClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="tradeButton"
                layoutX="178"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onTradeClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="bankButton"
                layoutX="264"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onBankClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="experimentCardButton"
                layoutX="350"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onBuyExperimentCardClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="declareVictoryButton"
                layoutX="436"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onDeclareVictoryClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="endTurnButton"
                layoutX="522"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onEndTurnClicked"
                styleClass="transparent-click-zone"/>

        <!-- Turn & phase indicator (label TURN/PHASE sudah ada di background) -->
        <Label fx:id="turnValueLabel"
                layoutX="822"
                layoutY="970"
                prefWidth="310"
                prefHeight="56"
                text="Player 1"
                styleClass="turn-phase-inline-label"/>

        <ImageView fx:id="phaseStatusImageView"
                   layoutX="822"
                   layoutY="1054"
                   fitWidth="250"
                   fitHeight="54"
                   preserveRatio="true"
                   smooth="true"
                   mouseTransparent="true">
            <image>
                <Image url="@../images/game/status_build.png"/>
            </image>
        </ImageView>

        <!-- Save/Load button di samping logbook (atas-bawah) -->
        <Button fx:id="saveGameButton"
                layoutX="1218"
                layoutY="974"
                prefWidth="160"
                prefHeight="78"
                onAction="#onSaveGameClicked"
                styleClass="save-load-click-zone"/>

        <Button fx:id="loadGameButton"
                layoutX="1218"
                layoutY="1066"
                prefWidth="160"
                prefHeight="78"
                onAction="#onLoadGameClicked"
                styleClass="save-load-click-zone"/>

        <!-- Players panel content (horizontal scroll untuk card experiment) -->
        <ScrollPane fx:id="playersBoardScrollPane"
                layoutX="1514"
                layoutY="150"
                prefWidth="340"
                prefHeight="479"
                fitToHeight="true"
                fitToWidth="false"
                hbarPolicy="AS_NEEDED"
                vbarPolicy="NEVER"
                pannable="true"
                styleClass="players-scroll">
            <content>
                <AnchorPane fx:id="playersBoardContentPane" prefWidth="640" prefHeight="479">
                    <!-- Row 1 -->
                    <ImageView fx:id="player1ProfileImage"
                            layoutX="0"
                            layoutY="0"
                            fitWidth="340"
                            fitHeight="110"
                            preserveRatio="false"
                            smooth="true"
                            mouseTransparent="true">
                        <viewport>
                            <Rectangle2D minX="24" minY="20" width="259" height="79"/>
                        </viewport>
                        <image>
                            <Image url="@../images/game/profile1.png"/>
                        </image>
                    </ImageView>
                    <Button fx:id="player1Button"
                            layoutX="0"
                            layoutY="0"
                            prefWidth="340"
                            prefHeight="110"
                            onAction="#onPlayer1Clicked"
                            styleClass="player-click-zone"/>
                    <Label fx:id="player1NameLabel" layoutX="104" layoutY="18" prefWidth="120" prefHeight="20" mouseTransparent="true" styleClass="player-name-label"/>
                    <Label fx:id="player1VpValueLabel" layoutX="87" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player1OutpostValueLabel" layoutX="139" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player1LabValueLabel" layoutX="191" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player1KnightValueLabel" layoutX="253" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player1PipeValueLabel" layoutX="305" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

                    <HBox fx:id="player1ExperimentCardsBox"
                          layoutX="356"
                          layoutY="8"
                          prefWidth="260"
                          prefHeight="94"
                          spacing="8"
                          mouseTransparent="true"
                          styleClass="experiment-card-row"/>

                    <!-- Row 2 -->
                    <ImageView fx:id="player2ProfileImage"
                            layoutX="0"
                            layoutY="123"
                            fitWidth="340"
                            fitHeight="110"
                            preserveRatio="false"
                            smooth="true"
                            mouseTransparent="true">
                        <viewport>
                            <Rectangle2D minX="5" minY="10" width="259" height="78"/>
                        </viewport>
                        <image>
                            <Image url="@../images/game/profile2.png"/>
                        </image>
                    </ImageView>
                    <Button fx:id="player2Button"
                            layoutX="0"
                            layoutY="123"
                            prefWidth="340"
                            prefHeight="110"
                            onAction="#onPlayer2Clicked"
                            styleClass="player-click-zone"/>
                    <Label fx:id="player2NameLabel" layoutX="104" layoutY="141" prefWidth="120" prefHeight="20" mouseTransparent="true" styleClass="player-name-label"/>
                    <Label fx:id="player2VpValueLabel" layoutX="87" layoutY="193" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player2OutpostValueLabel" layoutX="139" layoutY="193" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player2LabValueLabel" layoutX="191" layoutY="193" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player2KnightValueLabel" layoutX="253" layoutY="193" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player2PipeValueLabel" layoutX="305" layoutY="193" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

                    <HBox fx:id="player2ExperimentCardsBox"
                          layoutX="356"
                          layoutY="131"
                          prefWidth="260"
                          prefHeight="94"
                          spacing="8"
                          mouseTransparent="true"
                          styleClass="experiment-card-row"/>

                    <!-- Row 3 -->
                    <ImageView fx:id="player3ProfileImage"
                            layoutX="0"
                            layoutY="246"
                            fitWidth="340"
                            fitHeight="110"
                            preserveRatio="false"
                            smooth="true"
                            mouseTransparent="true">
                        <viewport>
                            <Rectangle2D minX="2" minY="1" width="260" height="80"/>
                        </viewport>
                        <image>
                            <Image url="@../images/game/profile3.png"/>
                        </image>
                    </ImageView>
                    <Button fx:id="player3Button"
                            layoutX="0"
                            layoutY="246"
                            prefWidth="340"
                            prefHeight="110"
                            onAction="#onPlayer3Clicked"
                            styleClass="player-click-zone"/>
                    <Label fx:id="player3NameLabel" layoutX="104" layoutY="264" prefWidth="120" prefHeight="20" mouseTransparent="true" styleClass="player-name-label"/>
                    <Label fx:id="player3VpValueLabel" layoutX="87" layoutY="316" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player3OutpostValueLabel" layoutX="139" layoutY="316" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player3LabValueLabel" layoutX="191" layoutY="316" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player3KnightValueLabel" layoutX="253" layoutY="316" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                    <Label fx:id="player3PipeValueLabel" layoutX="305" layoutY="316" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

                    <HBox fx:id="player3ExperimentCardsBox"
                          layoutX="356"
                          layoutY="254"
                          prefWidth="260"
                          prefHeight="94"
                          spacing="8"
                          mouseTransparent="true"
                          styleClass="experiment-card-row"/>

                    <!-- Row 4 -->
                    <Pane fx:id="player4RowPane" layoutX="0" layoutY="369" prefWidth="640" prefHeight="110">
                        <children>
                            <ImageView fx:id="player4ProfileImage"
                                    layoutX="0"
                                    layoutY="0"
                                    fitWidth="340"
                                    fitHeight="110"
                                    preserveRatio="false"
                                    smooth="true"
                                    mouseTransparent="true">
                                <viewport>
                                    <Rectangle2D minX="5" minY="7" width="264" height="81"/>
                                </viewport>
                                <image>
                                    <Image url="@../images/game/profile4.png"/>
                                </image>
                            </ImageView>
                            <Button fx:id="player4Button"
                                    layoutX="0"
                                    layoutY="0"
                                    prefWidth="340"
                                    prefHeight="110"
                                    onAction="#onPlayer4Clicked"
                                    styleClass="player-click-zone"/>
                            <Pane fx:id="player4DisabledOverlay"
                                  layoutX="0"
                                  layoutY="0"
                                  prefWidth="340"
                                  prefHeight="110"
                                  visible="false"
                                  mouseTransparent="true"
                                  styleClass="disabled-player-overlay"/>
                            <Label fx:id="player4NameLabel" layoutX="104" layoutY="18" prefWidth="120" prefHeight="20" mouseTransparent="true" styleClass="player-name-label"/>
                            <Label fx:id="player4VpValueLabel" layoutX="87" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                            <Label fx:id="player4OutpostValueLabel" layoutX="139" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                            <Label fx:id="player4LabValueLabel" layoutX="191" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                            <Label fx:id="player4KnightValueLabel" layoutX="253" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
                            <Label fx:id="player4PipeValueLabel" layoutX="305" layoutY="70" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

                            <HBox fx:id="player4ExperimentCardsBox"
                                  layoutX="356"
                                  layoutY="8"
                                  prefWidth="260"
                                  prefHeight="94"
                                  spacing="8"
                                  mouseTransparent="true"
                                  styleClass="experiment-card-row"/>
                        </children>
                    </Pane>
                </AnchorPane>
            </content>
        </ScrollPane>

        <!-- Logbook dynamic text -->
        <ScrollPane fx:id="logbookScrollPane"
                layoutX="1360"
                layoutY="807"
                prefWidth="488"
                prefHeight="278"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="logbook-scroll">

                <content>
                        <VBox fx:id="logbookBox"
                        spacing="6"
                        styleClass="logbook-content"/>
                </content>
        </ScrollPane>

        <!-- Popup overlay full screen -->
        <Pane fx:id="popupOverlay"
                layoutX="0"
                layoutY="0"
                prefWidth="1920"
                prefHeight="1148"
                visible="false"
                managed="false"
                styleClass="popup-overlay"/>

        <!-- Popup image -->
        <ImageView fx:id="popupImageView"
                layoutX="510"
                layoutY="140"
                fitWidth="900"
                fitHeight="650"
                preserveRatio="false"
                visible="false"
                managed="false"/>

        <!-- Close click zone untuk X bawaan popup image -->
        <Button fx:id="popupCloseButton"
                layoutX="1310"
                layoutY="238"
                prefWidth="52"
                prefHeight="52"
                visible="false"
                managed="false"
                onAction="#onClosePopupClicked"
                styleClass="popup-close-hitbox"/>

        <Button fx:id="popupExitToMenuButton"
                layoutX="580"
                layoutY="260"
                prefWidth="78"
                prefHeight="78"
                visible="false"
                managed="false"
                onAction="#onExitToMainMenuClicked"
                styleClass="popup-close-hitbox"/>

    </AnchorPane>

    
</StackPane>
