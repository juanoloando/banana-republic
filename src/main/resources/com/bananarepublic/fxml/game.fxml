<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="com.bananarepublic.ui.controller.GameController"
           styleClass="responsive-root">

    <AnchorPane fx:id="designPane"
                prefWidth="1920"
                prefHeight="1148">

        <ImageView fitWidth="1920"
                   fitHeight="1148"
                   preserveRatio="false"
                   smooth="true">
            <image>
                <Image url="@../images/game/main_game_bg.png"/>
            </image>
        </ImageView>

        <!-- Settings -->
        <Button layoutX="35"
                layoutY="44"
                prefWidth="72"
                prefHeight="72"
                onAction="#onSettingsClicked"
                styleClass="settings-click-zone"/>

        <!-- Board overlay: nanti HexRenderer render terrain/building di sini -->
        <Pane fx:id="boardPane"
              layoutX="315"
              layoutY="160"
              prefWidth="900"
              prefHeight="620"
              mouseTransparent="false"/>

        <!-- Timer label -->
        <Label fx:id="timerLabel"
                layoutX="140"
                layoutY="970"
                prefWidth="128"
                prefHeight="36"
                text="01:30"
                styleClass="timer-label"/>

        <!-- Bottom action buttons -->
        <Button fx:id="diceButton"
                layoutX="92"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onMouseClicked="#onDiceButtonClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="tradeButton"
                layoutX="178"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onTradeClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="bankButton"
                layoutX="264"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onBankClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="experimentCardButton"
                layoutX="350"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onBuyExperimentCardClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="declareVictoryButton"
                layoutX="436"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onDeclareVictoryClicked"
                styleClass="transparent-click-zone"/>

        <Button fx:id="endTurnButton"
                layoutX="522"
                layoutY="1025"
                prefWidth="74"
                prefHeight="74"
                onAction="#onEndTurnClicked"
                styleClass="transparent-click-zone"/>

        <!-- Player profile images -->
        <ImageView fx:id="player1ProfileImage"
                   layoutX="1514"
                   layoutY="150"
                   fitWidth="340"
                   fitHeight="110"
                   preserveRatio="false"
                   smooth="true"
                   mouseTransparent="true">
            <viewport>
                <Rectangle2D minX="24" minY="20" width="259" height="79"/>
            </viewport>
            <image>
                <Image url="@../images/game/profile1.png"/>
            </image>
        </ImageView>

        <ImageView fx:id="player2ProfileImage"
                   layoutX="1514"
                   layoutY="273"
                   fitWidth="340"
                   fitHeight="110"
                   preserveRatio="false"
                   smooth="true"
                   mouseTransparent="true">
            <viewport>
                <Rectangle2D minX="5" minY="10" width="259" height="78"/>
            </viewport>
            <image>
                <Image url="@../images/game/profile2.png"/>
            </image>
        </ImageView>

        <ImageView fx:id="player3ProfileImage"
                   layoutX="1514"
                   layoutY="396"
                   fitWidth="340"
                   fitHeight="110"
                   preserveRatio="false"
                   smooth="true"
                   mouseTransparent="true">
            <viewport>
                <Rectangle2D minX="2" minY="1" width="260" height="80"/>
            </viewport>
            <image>
                <Image url="@../images/game/profile3.png"/>
            </image>
        </ImageView>

        <ImageView fx:id="player4ProfileImage"
                   layoutX="1514"
                   layoutY="519"
                   fitWidth="340"
                   fitHeight="110"
                   preserveRatio="false"
                   smooth="true"
                   mouseTransparent="true">
            <viewport>
                <Rectangle2D minX="5" minY="7" width="264" height="81"/>
            </viewport>
            <image>
                <Image url="@../images/game/profile4.png"/>
            </image>
        </ImageView>

        <!-- Player cards click zones -->
        <Button fx:id="player1Button"
                layoutX="1514"
                layoutY="150"
                prefWidth="340"
                prefHeight="110"
                onAction="#onPlayer1Clicked"
                styleClass="player-click-zone"/>

        <Button fx:id="player2Button"
                layoutX="1514"
                layoutY="273"
                prefWidth="340"
                prefHeight="110"
                onAction="#onPlayer2Clicked"
                styleClass="player-click-zone"/>

        <Button fx:id="player3Button"
                layoutX="1514"
                layoutY="396"
                prefWidth="340"
                prefHeight="110"
                onAction="#onPlayer3Clicked"
                styleClass="player-click-zone"/>

        <Button fx:id="player4Button"
                layoutX="1514"
                layoutY="519"
                prefWidth="340"
                prefHeight="110"
                onAction="#onPlayer4Clicked"
                styleClass="player-click-zone"/>

        <!-- Kalau player cuma 3, overlay ini ditampilkan supaya player 4 terlihat mati/abu -->
        <Pane fx:id="player4DisabledOverlay"
              layoutX="1514"
              layoutY="519"
              prefWidth="340"
              prefHeight="110"
              visible="false"
              mouseTransparent="true"
              styleClass="disabled-player-overlay"/>

        <!-- Player stats: vp, pos pantau, lab, knight, longest pipe -->
        <Label fx:id="player1VpValueLabel" layoutX="1601" layoutY="220" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player1OutpostValueLabel" layoutX="1653" layoutY="220" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player1LabValueLabel" layoutX="1705" layoutY="220" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player1KnightValueLabel" layoutX="1767" layoutY="220" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player1PipeValueLabel" layoutX="1819" layoutY="220" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

        <Label fx:id="player2VpValueLabel" layoutX="1601" layoutY="343" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player2OutpostValueLabel" layoutX="1653" layoutY="343" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player2LabValueLabel" layoutX="1705" layoutY="343" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player2KnightValueLabel" layoutX="1767" layoutY="343" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player2PipeValueLabel" layoutX="1819" layoutY="343" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

        <Label fx:id="player3VpValueLabel" layoutX="1601" layoutY="466" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player3OutpostValueLabel" layoutX="1653" layoutY="466" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player3LabValueLabel" layoutX="1705" layoutY="466" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player3KnightValueLabel" layoutX="1767" layoutY="466" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player3PipeValueLabel" layoutX="1819" layoutY="466" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

        <Label fx:id="player4VpValueLabel" layoutX="1601" layoutY="589" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player4OutpostValueLabel" layoutX="1653" layoutY="589" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player4LabValueLabel" layoutX="1705" layoutY="589" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player4KnightValueLabel" layoutX="1767" layoutY="589" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>
        <Label fx:id="player4PipeValueLabel" layoutX="1819" layoutY="589" prefWidth="24" prefHeight="16" mouseTransparent="true" styleClass="player-stat-label"/>

        <!-- Logbook dynamic text -->
        <ScrollPane fx:id="logbookScrollPane"
                layoutX="1360"
                layoutY="807"
                prefWidth="488"
                prefHeight="278"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="logbook-scroll">

                <content>
                        <VBox fx:id="logbookBox"
                        spacing="6"
                        styleClass="logbook-content"/>
                </content>
        </ScrollPane>

        <!-- Popup overlay full screen -->
        <Pane fx:id="popupOverlay"
                layoutX="0"
                layoutY="0"
                prefWidth="1920"
                prefHeight="1148"
                visible="false"
                managed="false"
                styleClass="popup-overlay"/>

        <!-- Popup image -->
        <ImageView fx:id="popupImageView"
                layoutX="510"
                layoutY="140"
                fitWidth="900"
                fitHeight="650"
                preserveRatio="false"
                visible="false"
                managed="false"/>

        <!-- Close click zone untuk X bawaan popup image -->
        <Button fx:id="popupCloseButton"
                layoutX="1310"
                layoutY="238"
                prefWidth="52"
                prefHeight="52"
                visible="false"
                managed="false"
                onAction="#onClosePopupClicked"
                styleClass="popup-close-hitbox"/>

        <Button fx:id="popupExitToMenuButton"
                layoutX="580"
                layoutY="260"
                prefWidth="78"
                prefHeight="78"
                visible="false"
                managed="false"
                onAction="#onExitToMainMenuClicked"
                styleClass="popup-close-hitbox"/>

        <Label fx:id="player1NameLabel"
                layoutX="1618"
                layoutY="168"
                prefWidth="120"
                prefHeight="20"
                mouseTransparent="true"
                styleClass="player-name-label"/>

        <Label fx:id="player2NameLabel"
                layoutX="1618"
                layoutY="291"
                prefWidth="120"
                prefHeight="20"
                mouseTransparent="true"
                styleClass="player-name-label"/>

        <Label fx:id="player3NameLabel"
                layoutX="1618"
                layoutY="414"
                prefWidth="120"
                prefHeight="20"
                mouseTransparent="true"
                styleClass="player-name-label"/>

        <Label fx:id="player4NameLabel"
                layoutX="1618"
                layoutY="537"
                prefWidth="120"
                prefHeight="20"
                mouseTransparent="true"
                styleClass="player-name-label"/>
    </AnchorPane>

    
</StackPane>
