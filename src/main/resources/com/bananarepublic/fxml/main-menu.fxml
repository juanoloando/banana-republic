<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.view.MainMenuView"
           fx:id="rootPane"
           styleClass="main-menu-root">

    <VBox fx:id="menuButtons"
          alignment="CENTER"
          spacing="10">

        <HBox alignment="CENTER" spacing="8">
            <Button onAction="#onNewGameClicked"
                    styleClass="image-button">
                <graphic>
                    <ImageView fitWidth="175"
                               preserveRatio="true">
                        <image>
                            <Image url="@../images/mainmenu/btn_new_game.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button onAction="#onLoadGameClicked"
                    styleClass="image-button">
                <graphic>
                    <ImageView fitWidth="175"
                               preserveRatio="true">
                        <image>
                            <Image url="@../images/mainmenu/btn_load_game.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <Button onAction="#onExitClicked"
                styleClass="image-button">
            <graphic>
                <ImageView fitWidth="150"
                           preserveRatio="true">
                    <image>
                        <Image url="@../images/mainmenu/btn_exit.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

    </VBox>
</StackPane>
