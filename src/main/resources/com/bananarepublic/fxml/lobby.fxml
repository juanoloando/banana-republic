<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="com.bananarepublic.ui.controller.LobbyController"
           styleClass="responsive-root">

    <AnchorPane fx:id="designPane"
                minWidth="1280"
                minHeight="720"
                prefWidth="1280"
                prefHeight="720"
                maxWidth="1280"
                maxHeight="720">

        <!-- Background full template -->
        <ImageView fitWidth="1280"
                   fitHeight="720"
                   preserveRatio="false"
                   smooth="true">
            <image>
                <Image url="@../images/lobby/new_game_bg.png"/>
            </image>
        </ImageView>

        <!-- Settings button kiri atas -->
        <Button layoutX="28"
                layoutY="27"
                prefWidth="62"
                prefHeight="62"
                onAction="#onSettingsClicked"
                styleClass="transparent-click-zone"/>

        <!-- Toggle Number of Players -->
        <HBox layoutX="318"
              layoutY="280"
              spacing="12">
            <ToggleButton fx:id="threePlayerToggle"
                          text="3"
                          prefWidth="70"
                          prefHeight="36"
                          styleClass="player-count-toggle"/>

            <ToggleButton fx:id="fourPlayerToggle"
                          text="4"
                          prefWidth="70"
                          prefHeight="36"
                          styleClass="player-count-toggle"/>
        </HBox>

        <!-- Player name input -->
        <TextField fx:id="player1NameField"
                   layoutX="299"
                   layoutY="397"
                   prefWidth="285"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <TextField fx:id="player2NameField"
                   layoutX="299"
                   layoutY="456"
                   prefWidth="285"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <TextField fx:id="player3NameField"
                   layoutX="299"
                   layoutY="516"
                   prefWidth="285"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <TextField fx:id="player4NameField"
                   layoutX="299"
                   layoutY="576"
                   prefWidth="285"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <!-- Environment Data label -->
        <Label fx:id="environmentFileLabel"
               layoutX="633"
               layoutY="290"
               prefWidth="372"
               prefHeight="82"
               text="No File Chosen"
               mouseTransparent="true"
               styleClass="plugin-file-label"/>

        <!-- Environment Data upload click zone -->
        <Button layoutX="1002"
                layoutY="299"
                prefWidth="55"
                prefHeight="47"
                onAction="#onEnvironmentDataClicked"
                styleClass="transparent-click-zone"/>

        <!-- Automation Intelligence label -->
        <Label fx:id="automationFileLabel"
               layoutX="633"
               layoutY="448"
               prefWidth="372"
               prefHeight="82"
               text="No File Chosen"
               mouseTransparent="true"
               styleClass="plugin-file-label"/>

        <!-- Automation Intelligence upload click zone -->
        <Button layoutX="1002"
                layoutY="463"
                prefWidth="55"
                prefHeight="47"
                onAction="#onAutomationIntelligenceClicked"
                styleClass="transparent-click-zone"/>

        <!-- Cancel button -->
        <Button layoutX="665"
                layoutY="594"
                prefWidth="177"
                prefHeight="51"
                onAction="#onCancelClicked"
                styleClass="transparent-click-zone"/>

        <!-- Start Game button -->
        <Button layoutX="858"
                layoutY="594"
                prefWidth="187"
                prefHeight="51"
                onAction="#onStartGameClicked"
                styleClass="transparent-click-zone"/>

    </AnchorPane>
</StackPane>
