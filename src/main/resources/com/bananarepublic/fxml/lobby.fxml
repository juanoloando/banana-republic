<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="com.bananarepublic.view.LobbyView"
           styleClass="responsive-root">

    <AnchorPane fx:id="designPane"
                minWidth="1280"
                minHeight="720"
                prefWidth="1280"
                prefHeight="720"
                maxWidth="1280"
                maxHeight="720">

        <!-- Background full template -->
        <ImageView fitWidth="1280"
                   fitHeight="720"
                   preserveRatio="false"
                   smooth="true">
            <image>
                <Image url="@../images/lobby/new_game_revision.png"/>
            </image>
        </ImageView>

        <ImageView fx:id="player4RowCover"
                   layoutX="220"
                   layoutY="552"
                   fitWidth="430"
                   fitHeight="92"
                   preserveRatio="false"
                   smooth="true"
                   mouseTransparent="true"
                   visible="false">
            <image>
                <Image url="@../images/lobby/player4_row_cover.png"/>
            </image>
        </ImageView>

        <!-- Settings button kiri atas -->
        <Button layoutX="28"
                layoutY="27"
                prefWidth="62"
                prefHeight="62"
                onAction="#onSettingsClicked"
                styleClass="transparent-click-zone"/>

        <!-- Toggle Number of Players -->
        <HBox layoutX="318"
              layoutY="280"
              spacing="12">
            <ToggleButton fx:id="threePlayerToggle"
                          text="3"
                          prefWidth="70"
                          prefHeight="36"
                          styleClass="player-count-toggle"/>

            <ToggleButton fx:id="fourPlayerToggle"
                          text="4"
                          prefWidth="70"
                          prefHeight="36"
                          styleClass="player-count-toggle"/>
        </HBox>

        <!-- Player name input -->
        <TextField fx:id="player1NameField"
                   layoutX="299"
                   layoutY="397"
                   prefWidth="230"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <TextField fx:id="player2NameField"
                   layoutX="299"
                   layoutY="456"
                   prefWidth="230"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <TextField fx:id="player3NameField"
                   layoutX="299"
                   layoutY="516"
                   prefWidth="230"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <TextField fx:id="player4NameField"
                   layoutX="299"
                   layoutY="576"
                   prefWidth="230"
                   prefHeight="39"
                   styleClass="wood-input"/>

        <Button fx:id="player1BotButton"
                layoutX="545"
                layoutY="394"
                prefWidth="38"
                prefHeight="38"
                onAction="#onPlayer1BotClicked"
                styleClass="robot-button">
            <graphic>
                <ImageView fitWidth="32"
                           fitHeight="32"
                           preserveRatio="true"
                           smooth="false">
                    <image>
                        <Image url="@../images/lobby/robot_button.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="player2BotButton"
                layoutX="545"
                layoutY="454"
                prefWidth="38"
                prefHeight="38"
                onAction="#onPlayer2BotClicked"
                styleClass="robot-button">
            <graphic>
                <ImageView fitWidth="32"
                           fitHeight="32"
                           preserveRatio="true"
                           smooth="false">
                    <image>
                        <Image url="@../images/lobby/robot_button.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="player3BotButton"
                layoutX="545"
                layoutY="514"
                prefWidth="38"
                prefHeight="38"
                onAction="#onPlayer3BotClicked"
                styleClass="robot-button">
            <graphic>
                <ImageView fitWidth="32"
                           fitHeight="32"
                           preserveRatio="true"
                           smooth="false">
                    <image>
                        <Image url="@../images/lobby/robot_button.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="player4BotButton"
                layoutX="545"
                layoutY="574"
                prefWidth="38"
                prefHeight="38"
                onAction="#onPlayer4BotClicked"
                styleClass="robot-button">
            <graphic>
                <ImageView fitWidth="32"
                           fitHeight="32"
                           preserveRatio="true"
                           smooth="false">
                    <image>
                        <Image url="@../images/lobby/robot_button.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Environment Data label -->
        <Label fx:id="environmentFileLabel"
               layoutX="633"
               layoutY="290"
               prefWidth="372"
               prefHeight="82"
               text="No File Chosen"
               mouseTransparent="true"
               styleClass="plugin-file-label"/>

        <!-- Environment Data upload click zone -->
        <Button layoutX="1002"
                layoutY="299"
                prefWidth="55"
                prefHeight="47"
                onAction="#onEnvironmentDataClicked"
                styleClass="transparent-click-zone"/>

        <!-- Automation Intelligence info -->
        <ScrollPane layoutX="665"
                    layoutY="438"
                    prefWidth="380"
                    prefHeight="142"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="automation-info-scroll">
            <content>
                <VBox fx:id="automationInfoBox"
                      spacing="10"
                      styleClass="automation-info-box"/>
            </content>
        </ScrollPane>

        <!-- Cancel button -->
        <Button layoutX="665"
                layoutY="594"
                prefWidth="177"
                prefHeight="51"
                onAction="#onCancelClicked"
                styleClass="transparent-click-zone"/>

        <!-- Start Game button -->
        <Button layoutX="858"
                layoutY="594"
                prefWidth="187"
                prefHeight="51"
                onAction="#onStartGameClicked"
                styleClass="transparent-click-zone"/>

    </AnchorPane>
</StackPane>
